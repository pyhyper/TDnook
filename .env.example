# LLM & API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Local LLM Inference (Optional: path to GGUF model or HuggingFace directory)
LOCAL_MODEL_PATH=./models/gemma-model.gguf
MODEL_N_CTX=2048
MODEL_N_BATCH=512
MODEL_N_GPU_LAYERS=0
MODEL_N_THREADS=4

# Vector Database & Retrieval Settings
VECTOR_DB_PATH=./data/vector_db
TOP_K=5
EMBEDDING_BATCH_SIZE=32

# OCR Settings (EasyOCR languages, comma-separated)
OCR_LANGUAGES=vi,en
